# ── GOOGLE GEMINI AI ─────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_api_key_here

# ── ELEVENLABS TTS (AI Voice) ─────────────────────────────────────────────────
# Get from: https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Default voice: Rachel. Get other IDs from: https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── FIREBASE (Frontend — VITE_ prefix exposes to browser safely) ───────────────
# Get from: Firebase Console → Project Settings → Your Apps → Web App → Config
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdefgh

# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=5000
